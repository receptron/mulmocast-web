{
  "name": "mulmocast-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "config:dev": "cp src/configs/config-dev.ts src/configs/config.ts",
    "config:prod": "cp src/configs/config-prod.ts src/configs/config.ts",
    "lint": "eslint",
    "format": "prettier --write 'src/**/*.{ts,json,yaml,vue}' *.json *.ts *.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@unhead/vue": "^2.1.12",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "mulmocast-viewer": "^0.2.4",
    "reka-ui": "^2.10.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.38",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.5.0",
    "eslint-plugin-sonarjs": "^4.1.0",
    "eslint-plugin-vue": "^10.9.2",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-vue-devtools": "^8.1.3",
    "vue-tsc": "^3.3.5"
  }
}
